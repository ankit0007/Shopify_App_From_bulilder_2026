<div
  class="formbuilder-block"
  data-form-builder-form-id="{{ block.settings.form_public_id | escape }}"
  data-form-builder-endpoint="/apps/form-builder/forms"
  role="region"
  aria-label="{{ block.settings.accessible_label | escape }}"
>
  {% if block.settings.form_public_id == blank %}
    <p class="formbuilder-loading">Choose a form public ID in the block settings.</p>
  {% else %}
    <p class="formbuilder-loading">{{ block.settings.loading_text | escape }}</p>
  {% endif %}
</div>
{{ 'form-builder.js' | asset_url | script_tag }}
{{ 'form-builder.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Form Builder form",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "form_public_id",
      "label": "Form public ID",
      "info": "Use the immutable public ID shown in the app, not the form name."
    },
    {
      "type": "text",
      "id": "accessible_label",
      "label": "Accessible label",
      "default": "Form"
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Loading text",
      "default": "Loading form…"
    }
  ]
}
{% endschema %}
